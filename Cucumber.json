{
  "default": {
    "tags": "@todomvc",
    "dryRun": false,
    "formatOptions": {
      "snippetInterface": "async-await"
    },
    "paths": [
      "PlaywrightWithTypescript/FeatureFiles/**/*.feature"

      
    ],
    "require": [
      "PlaywrightWithTypescript/StepDefination/**/*.ts"
    ],
    "requireModule": [
      "ts-node/register"
    ],
    "format": [
      "progress-bar",
      "html:test-result/cucumber-report.html",
      "json:test-result/cucumber-report.json",
      "rerun:@rerun.txt"
    ],
    "parallel": 0,
    "rerun": 0
  }
}