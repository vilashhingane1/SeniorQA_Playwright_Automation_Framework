{
  "name": "seniorqa_playwright_automation_framework",
  "version": "1.0.0",
  "description": "PlaywrightFrameworkAssigementstask",
  "license": "ISC",
  "author": "",
  "type": "commonjs",
  "scripts": {
    "test": "cross-env HEADED=true playwright test --project=chromium && cross-env HEADED=true cucumber-js --config Cucumber.json && npm run allure:generate",
    "test:headless": "playwright test --project=chromium && cucumber-js --config Cucumber.json",
    "test:playwright": "cross-env HEADED=true playwright test --project=chromium",
    "test:bdd": "cross-env HEADED=true cucumber-js --config Cucumber.json",
    "test:bdd:todomvc": "cross-env HEADED=true cucumber-js --config Cucumber.json --tags @todomvc",
    "typecheck": "tsc --noEmit",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^9.6.0",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.7",
    "allure-commandline": "^2.46.2",
    "allure-playwright": "^3.15.0",
    "cross-env": "^10.1.0",
    "cucumber-html-reporter": "^5.0.2",
    "dotenv": "^18.0.10",
    "playwright": "^1.65.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "zod": "^4.6.7"
  }
}
